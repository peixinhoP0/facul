chess(Lista) :-
    processar(Lista, [], Tabuleiro),
    length(Tabuleiro, Tam),
    nl, format('--- Tabuleiro com ~w casas ---~n', [Tam]),
    imprimir_tabuleiro(Tabuleiro).

% lista de comando 
processar([], Tabu, Tabu).
processar([X|Y], TabuAtual, TabuFinal) :-
    (   string(X)
    ->  format('processando linha de texto: ~w~n', [X]),
        string_chars(X, Chars),
        percorrer_caracteres(Chars, TabuAtual, TabuProximo)
    ;   integer(X)
    ->  format('Espaços vazios: ~w~n', [X]),
        addNum(X, TabuAtual, TabuProximo)
    ;   TabuProximo = TabuAtual
    ),
    processar(Y, TabuProximo, TabuFinal).

% caracteres de uma string 
percorrer_caracteres([], Tabu, Tabu).
percorrer_caracteres([H|T], TabuAtual, TabuFinal) :-
    (   char_type(H, digit(N))          % '2' -> N = 2
    ->  addNum(N, TabuAtual, TabuProximo)
    ;   H == '/'                        % separador do FEN
    ->  TabuProximo = TabuAtual
    ;   append(TabuAtual, [H], TabuProximo)   % peça
    ),
    percorrer_caracteres(T, TabuProximo, TabuFinal).

%  Adiciona N vezes 'X' 
addNum(N, TabuAtual, TabuFinal) :-
    length(Xs, N),
    maplist(=('X'), Xs),
    append(TabuAtual, Xs, TabuFinal).

% Impressão 8x8 
imprimir_tabuleiro([]).
imprimir_tabuleiro(Lista) :-
    Lista \= [],
    length(Linha, 8),
    append(Linha, Resto, Lista),
    atomic_list_concat(Linha, ' ', Texto),
    writeln(Texto),
    imprimir_tabuleiro(Resto).
