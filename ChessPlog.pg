%plano: apos receber a Lista com os comandos (notação forsyth) ele vai 
% pegar cada linha do tabuleiro
% se for uma string ele vai pegar cada caracter separadamente e adicionar em uma lista "Tabuleiro de tamanho 64"
%se for um numero ele vai adicionar a letra X na quantidade dos numeros




chess(Lista):-
    length(Tabuleiro , 64),
    processar(Lista,[],Tabuleiro).


processar([],Tabu,Tabu).
processar([X|Y],TabuAtual, TabuFinal) :-
    (   string(X) 
    ->  string_chars(X, Chars),
        format('processando linha de texto:~w~n', [X]),
        append(TabuAtual, Chars, TabuProximo)
    ;   integer(X)
    ->  format('Espaços vazios: ~w~n',[X]),    
    	addNum(X,TabuAtual,TabuFinal)
    ;   TabuProximo=TabuAtual
    ),
    processar(Y,TabuProximo,TabuFinal).

percorrer_caracteres([],TabuFinal,TabuFinal).
percorrer_caracteres([H|T],TabuAtual, TabuFinal) :-
    format('  Caractere: ~w~n', [H]),
    
    (   atom(H) %se for uma string de um char.    
    ->  append(TabuAtual,[H],TabuProximo) %se sim, junta TabuAtual e H em tabu próximo.
    ;   TabuProximo=TabuAtual % else if, mantém o tabuleiro como está. 
	),
    percorrer_caracteres(T,TabuProximo,TabuFinal).
    

addNum(N,TabuAtual,TabuFinal):-
    length(Y,N),
    maplist(=("X"),N),
    append(TabuAtual, Y, TabuFinal).
    
    
